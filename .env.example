# ============================================================================
# Reel Generator - Environment Variables & API Keys Template
# ============================================================================
# Copy this file to .env and fill in your actual API keys.
# .env is gitignored and will never be committed to git.

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Pexels API Key (from https://www.pexels.com/api/)
PEXELS_API_KEY=YOUR_PEXELS_API_KEY_HERE

# Tenor API Key (for B-roll animated loops: https://developers.google.com/tenor)
TENOR_API_KEY=YOUR_TENOR_API_KEY_HERE

# ── YouTube OAuth2 ──────────────────────────────────────────────────────────
# 1. Create OAuth2 credentials at: Google Cloud Console → APIs & Services → Credentials
# 2. Enable YouTube Data API v3
# 3. Run: python get_youtube_token.py  (opens browser for consent)
# 4. Paste the printed refresh_token below
YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID_HERE
YOUTUBE_CLIENT_SECRET=YOUR_YOUTUBE_CLIENT_SECRET_HERE
YOUTUBE_REFRESH_TOKEN=YOUR_YOUTUBE_REFRESH_TOKEN_HERE

# ── Instagram Credentials ──────────────────────────────────────────────────
# Option 1: Instagrapi (Direct local MP4 file upload - Recommended)
INSTAGRAM_USERNAME=YOUR_INSTAGRAM_USERNAME_HERE
INSTAGRAM_PASSWORD=YOUR_INSTAGRAM_PASSWORD_HERE

# Option 2: Meta Graph API (Requires publicly hosted CDN URL)
INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN_HERE
INSTAGRAM_BUSINESS_ACCOUNT_ID=YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID_HERE
META_APP_ID=YOUR_META_APP_ID_HERE
META_APP_SECRET=YOUR_META_APP_SECRET_HERE